generator client {
  provider        = "prisma-client-js"
  // Enables the optional Neon HTTP driver in lib/prisma.ts, used only when
  // PRISMA_NEON_HTTP=true. The default TCP path is unaffected by this flag.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (Clerk sync) ────────────────────────────────────────────────────────
// id = Clerk's external userId string (e.g. "user_2xyz...").
// Using the Clerk ID directly as PK avoids a translation layer — existing
// userId String fields in Bet/Bankroll/WatchlistItem relate directly.
model User {
  id        String   @id           // Clerk userId
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets                 Bet[]
  bankroll             Bankroll?
  watchlist            WatchlistItem[]
  bankrollTransactions BankrollTransaction[]
  backtestRuns         BacktestRun[]
  modelPredictions     ModelPrediction[]
  subscription         Subscription?
  apiKey               UserApiKey?

  @@map("users")
}

// ─── UserApiKey (user-supplied Anthropic key, encrypted at rest) ────────────
// One row per Clerk userId, created/updated when the user sets a key on
// /account. encryptedKey is never selected into any broad User query — only
// read and decrypted inside app/api/chat/route.ts immediately before
// constructing the per-request Anthropic client.
model UserApiKey {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  encryptedKey String   // AES-256-GCM ciphertext, base64: iv:authTag:ciphertext
  lastFour     String   // last 4 chars of the plaintext key, for the masked UI indicator

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_api_keys")
}

// ─── Subscription (Stripe-backed tier management) ────────────────────────────
// One row per Clerk userId. Created when a checkout session is initiated.
// tier: "FREE" | "PRO" | "ELITE"
// status mirrors Stripe subscription status: "active" | "trialing" | "past_due" | "canceled" | "inactive"
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tier                 String    @default("FREE")     // "FREE" | "PRO" | "ELITE"
  status               String    @default("inactive") // mirrors Stripe status

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?

  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

// ─── Watchlist ────────────────────────────────────────────────────────────────
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([userId])
  @@map("watchlist")
}

// ─── Bets ─────────────────────────────────────────────────────────────────────
model Bet {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId     String
  amount     Float
  odds       Float
  prediction String   // "NRFI" | "YRFI"
  result     String?  // "NRFI" | "YRFI" | null when pending
  pnl        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bankrollTransactions BankrollTransaction[]

  @@index([userId])
  @@index([gameId])
  @@map("bets")
}

// ─── Bankroll ─────────────────────────────────────────────────────────────────
model Bankroll {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  startingBalance Float
  currentBalance  Float
  updatedAt       DateTime @updatedAt

  @@map("bankroll")
}

// ─── Bankroll Transactions (per-transaction ledger) ───────────────────────────
model BankrollTransaction {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "deposit" | "withdrawal" | "win" | "loss" | "adjustment"
  type    String
  amount  Float
  balance Float    // running balance after this transaction
  betId   String?
  bet     Bet?     @relation(fields: [betId], references: [id], onDelete: SetNull)
  note    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([betId])
  @@index([createdAt])
  @@map("bankroll_transactions")
}

// ─── Historical Game Results (global — not user-scoped) ───────────────────────
model GameResult {
  gamePk   Int      @id
  date     String
  season   Int
  homeTeam String
  awayTeam String
  homeRuns Int
  awayRuns Int
  nrfi     Boolean
  syncedAt DateTime @default(now())

  @@index([date])
  @@index([season])
  @@map("game_results")
}

// ─── Model Predictions (system-wide; optionally user-scoped when saved) ───────
model ModelPrediction {
  id              String   @id
  userId          String?  // null = system/shared; set when a user explicitly saves
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  date            String
  season          Int
  homeTeam        String
  awayTeam        String
  homePitcher     String   @default("")
  awayPitcher     String   @default("")
  nrfiProbability Float
  prediction      String
  confidence      String
  confidenceScore Float
  poissonNrfi     Float
  zipNrfi         Float
  markovNrfi      Float
  ensembleNrfi    Float
  // Remaining 3 of the 7-model ensemble, nullable — absent on rows written
  // before these columns existed, and on historical-sync rows built from a
  // degraded (no-lineup) recompute where a meta-model input was missing.
  mapreNrfi              Float?
  logisticMetaNrfi       Float?
  nnInteractionNrfi      Float?
  hierarchicalBayesNrfi  Float?
  // American odds snapshot at prediction time (null when no odds were available
  // — e.g. historical backfill).  Lets backtests price each side at its real
  // line instead of a synthetic -110 (AUDIT_REPORT.md P1-3/P1-7).
  nrfiOdds        Float?
  yrfiOdds        Float?
  // ── Ensemble++ extensions (all nullable for backwards compatibility) ───────
  deepNrfi              Float?
  deepNrfiTopFeatures   Json?
  monteCarloPNrfi       Float?
  monteCarloMeanRuns    Float?
  monteCarloVariance    Float?
  monteCarloDistribution Json?
  ensembleVersion       String  @default("v1.7models")
  // Data-lineage flag set by both the live and historical-sync paths.  When
  // null, treat as "unknown" (pre-Phase-5 rows).  Shape:
  //   { weather: bool, odds: bool, lineup: bool, recomputedAt?: string }
  inputsPresence  Json?
  modelBreakdown  Json?    // { logisticMetaNrfi, nnInteractionNrfi, hierarchicalBayesNrfi, homeZipOmega, awayZipOmega, homeBayesianWeight, awayBayesianWeight, modelInputs }
  modelConsensus  Float    @default(0.5)
  actualResult    String?
  correct         Boolean?
  status          String   @default("pending")
  backtested      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([season])
  @@index([status])
  @@index([userId])
  @@map("model_predictions")
}

// ─── Free Pick (pinned FREE-tier daily pick) ──────────────────────────────────
// Written once per ET date by lib/server/free-pick.ts, on the first
// /api/predictions request that produces a non-empty rawPredictions slate —
// insert-only, so later requests can't move the pin as odds/lineups shift
// the ranking during the day. No relation to ModelPrediction: gameId matches
// ModelPrediction.id / NRFIPrediction.gameId by convention, but that row may
// not exist yet (or ever) at pin time — do not add a FK here.
// A date with no row here (every pre-migration date, or one where every pin
// attempt hit a DB error) falls back to the argmax-over-ModelPrediction
// reconstruction in lib/free-pick-accuracy.ts.
model FreePick {
  date            String   @id
  gameId          String
  confidenceScore Float
  createdAt       DateTime @default(now())

  @@map("free_picks")
}

// ─── Ensemble Diagnostics ─────────────────────────────────────────────────────
// Written only when ENABLE_DIAGNOSTICS=true — tracks per-game ensemble diagnostics.
model EnsembleDiagnostic {
  id              String   @id @default(cuid())
  gameId          String
  date            String
  poissonWeight   Float
  zipWeight       Float
  markovWeight    Float
  mapreWeight     Float
  logisticWeight  Float
  nnWeight        Float
  hierBayesWeight Float
  rawEnsemble7    Float
  calibrated      Float
  finalBlended    Float
  // ── Ensemble++ extensions (all nullable; legacy rows leave them null) ──────
  deepNrfiOutput   Float?
  monteCarloOutput Float?
  deepNrfiWeight   Float?
  monteCarloWeight Float?
  ensembleVersion  String  @default("v1.7models")
  rawEnsemble9     Float?
  calibratedV2     Float?
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([gameId])
  @@index([ensembleVersion])
  @@map("ensemble_diagnostics")
}

// ─── Ensemble++ Phase 1: Statcast caches ──────────────────────────────────────
// Populated by scripts/data/refresh_statcast.py (pybaseball nightly dump).
// Empty when the Phase 6 cron isn't wired yet — engine degrades gracefully.

model PitcherStatcast {
  id        String   @id @default(cuid())
  mlbamId   String
  date      DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())

  @@unique([mlbamId, date])
  @@index([mlbamId])
  @@map("pitcher_statcast")
}

model BatterStatcast {
  id        String   @id @default(cuid())
  mlbamId   String
  date      DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())

  @@unique([mlbamId, date])
  @@index([mlbamId])
  @@map("batter_statcast")
}

// ─── Backtest Runs (Phase 3: walk-forward validation framework) ───────────────
model BacktestRun {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonStart Int
  seasonEnd   Int
  totalGames  Int      @default(0)
  brierScore  Float?
  accuracy    Float?
  roiKelly    Float?
  roiFlat     Float?
  sharpe      Float?
  maxDrawdown Float?
  // "pending" | "running" | "done" | "error"
  status      String   @default("pending")
  // Rich metrics blob: calibration points, monthly breakdown, ablation results, etc.
  results     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("backtest_runs")
}
